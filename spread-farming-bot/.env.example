# ===================================================================
# SPREAD FARMING BOT CONFIGURATION
# ===================================================================

# === POLYMARKET CREDENTIALS ===
POLY_PRIVATE_KEY=0xYOUR_WALLET_PRIVATE_KEY_HERE
POLY_FUNDER=0xYOUR_WALLET_ADDRESS_HERE

# === BOT CONFIGURATION ===

# Dry run mode (1 = paper trading, 0 = live execution)
# IMPORTANT: Start with dry run until you understand the strategy!
SPREAD_DRY_RUN=1

# Spread in basis points (100 bps = 1%)
# Default: 400 bps = 4% spread (bid at mid-2%, ask at mid+2%)
# Lower = more fills but less profit per fill
# Higher = less fills but more profit per fill
SPREAD_BPS=400

# Maximum position per market in USD
# This limits your risk exposure per market
MAX_POSITION_PER_MARKET=500

# Minimum order size in USD (Polymarket minimum is ~$1)
MIN_ORDER_SIZE=2.0

# How often to update orders (milliseconds)
# Lower = more responsive but more API calls
# Higher = less responsive but fewer API calls
UPDATE_INTERVAL_MS=5000

# === LOGGING ===
RUST_LOG=spread_farming_bot=info

# === NOTES ===
# - Use same wallet as arbitrage bot or separate wallet
# - Fund wallet with USDC on Polygon network
# - Start with small positions to test strategy
# - Monitor P&L closely for first 24 hours
