# ============================================================
# ARBITRAGE BOT CONFIGURATION FILE
# ============================================================
# Copy this file to ".env" and fill in your API credentials
#
# To copy: Run this command in terminal:
#   cp .env.example .env
#
# Then edit the .env file with your real credentials
# ============================================================

# ============================================================
# REQUIRED: KALSHI API CREDENTIALS
# ============================================================
# Get these from: https://kalshi.com/settings/api
#
# Your Kalshi API Key ID (looks like a long string of letters/numbers)
KALSHI_API_KEY_ID=your_kalshi_api_key_id_here

# Path to your Kalshi private key file (download from Kalshi)
# Put the file somewhere safe and enter the full path here
# Example on Mac: /Users/yourname/keys/kalshi_private_key.pem
# Example on Windows: C:\Users\yourname\keys\kalshi_private_key.pem
# Example on Linux: /home/yourname/keys/kalshi_private_key.pem
KALSHI_PRIVATE_KEY_PATH=/path/to/your/kalshi_private_key.pem

# ============================================================
# REQUIRED: POLYMARKET API CREDENTIALS
# ============================================================
# Get these from your Polymarket wallet
#
# Your Polymarket wallet private key (starts with 0x...)
# IMPORTANT: Keep this secret! Never share it!
POLY_PRIVATE_KEY=0x_your_polymarket_private_key_here

# Your Polymarket funder/wallet address (starts with 0x...)
POLY_FUNDER=0x_your_polymarket_wallet_address_here

# ============================================================
# SAFETY SETTINGS (Recommended to start with)
# ============================================================
# DRY_RUN=1 means NO real trades - just simulates everything
# Start with 1 to test, change to 0 when ready to trade for real
DRY_RUN=1

# ============================================================
# PRIORITY MODE SETTINGS (The new features!)
# ============================================================
# Set to 1 to enable priority mode (new sorting features)
# Set to 0 to use original mode
PRIORITY_MODE=1

# How often to re-sort the queue (in seconds)
# Default: 5 seconds
QUEUE_SORT_INTERVAL_SECS=5

# Minimum trade size per side (in cents)
# 25000 = $250 minimum
MIN_LIQUIDITY_CENTS=25000

# Maximum trade size per side (in cents)
# 250000 = $2,500 maximum
MAX_LIQUIDITY_CENTS=250000

# Minimum profit percentage to execute a trade
# 1.0 = only trade if profit is 1% or higher
MIN_ARB_PERCENT=1.0

# How much to boost live games in priority (higher = more priority)
# Default: 10.0
LIVE_PRIORITY_BOOST=10.0

# ============================================================
# CIRCUIT BREAKER / SAFETY LIMITS (Optional - uses defaults if not set)
# ============================================================
# Max position per market in cents (default: 500000 = $5000)
# CB_MAX_POSITION_PER_MARKET=500000

# Max total position in cents (default: 2000000 = $20000)
# CB_MAX_TOTAL_POSITION=2000000

# Max daily loss in cents before stopping (default: 100000 = $1000)
# CB_MAX_DAILY_LOSS=100000

# Enable circuit breaker (default: true)
# CB_ENABLED=true

# ============================================================
# LOGGING (Optional)
# ============================================================
# Set to 1 to see detailed price logging
# PRICE_LOGGING=0
